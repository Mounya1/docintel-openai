# Copy to .env and fill in. Never commit the real .env.

APP_ENV=development
APP_SECRET_KEY=change-me
JWT_SECRET_KEY=change-me

# Local Postgres from docker-compose (SQLite also works: sqlite+aiosqlite:///./data/docintel.db)
DATABASE_URL=postgresql+asyncpg://docintel:docintel_secret@localhost:5432/docintel

# AI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# AWS S3 (leave S3_BUCKET_NAME blank to store uploads on local disk)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=

# Background queue (docker-compose turns this on with Redis + Celery)
USE_CELERY=false
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50
LOG_LEVEL=INFO
