# Copy to deploy/.env.prod on the server and fill in. Never commit the real file.

# Public hostname Caddy serves: the server's public IP with dashes + .sslip.io
API_DOMAIN=1-2-3-4.sslip.io

APP_ENV=production
FRONTEND_URL=https://your-project.vercel.app
LOG_LEVEL=INFO

# Neon: paste the connection string as Neon shows it. Use the DIRECT one
# (host without "-pooler"); the pooled endpoint breaks asyncpg. The app converts
# sslmode/channel_binding to what asyncpg expects on startup.
DATABASE_URL=postgresql://neondb_owner:CHANGE_ME@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require

OPENAI_API_KEY=sk-...
# gpt-4o-mini is far cheaper than gpt-4o and good enough for most extraction
OPENAI_MODEL=gpt-4o-mini

# Generate each with: openssl rand -hex 32
APP_SECRET_KEY=
JWT_SECRET_KEY=

# S3 for uploaded files. Oracle has no AWS instance role, so set the keys of an
# IAM user limited to this bucket (e.g. the existing "docintel" user).
AWS_REGION=us-east-1
S3_BUCKET_NAME=docintelfilesproject
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

USE_CELERY=false
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=50
